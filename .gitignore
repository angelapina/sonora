# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
public/uploads/*
!public/uploads/.gitkeep

# scaffolding de skills de IA generada automáticamente por `prisma init`
# (no forma parte de la app; se regenera con "npx prisma init" si hace falta)
.agents/
.windsurf/
.claude/skills/
skills-lock.json

# base de datos SQLite local de desarrollo (se sustituye por Postgres en producción)
*.db
*.db-journal
