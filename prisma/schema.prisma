// Sonora — esquema de datos (Prisma Postgres)
// Los "enum" se modelan como String documentado + validación con zod en la app
// (así el modelo es portable entre proveedores sin tocar migraciones), y las
// taxonomías multivalor (tipo de artista, género, instrumento, tipo de evento)
// se modelan como tablas de referencia + relaciones muchos-a-muchos implícitas,
// gestionables desde el panel de administración.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuarios ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CLIENT") // CLIENT | MUSICIAN | ADMIN
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  musicianProfile MusicianProfile?
  bookingRequests BookingRequest[]
  favorites       Favorite[]
  reviews         Review[]
  messages        Message[]

  @@index([role])
}

// ---------- Perfil de músico ----------

model MusicianProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug            String    @unique
  stageName       String
  tagline         String? // frase corta bajo el nombre
  avatarUrl       String?
  coverUrl        String?
  city            String
  zone            String? // zona/comarca donde también se desplaza
  bio             String?
  priceFrom       Int? // euros, precio orientativo "desde"
  priceNote       String? // texto libre p.ej. "Según duración y desplazamiento"
  yearsExperience Int?
  website         String?
  instagram       String?
  youtube         String?
  tiktok          String?
  spotify         String?
  phone           String?
  contactEmail    String?
  status          String    @default("draft") // draft | published
  featured        Boolean   @default(false)
  featuredUntil   DateTime?
  plan            String    @default("free") // free | premium
  ratingAvg       Float     @default(0)
  ratingCount     Int       @default(0)

  // --- Señales de confianza (marketplace) ---
  verified        Boolean   @default(false) // identidad + perfil revisados por Sonora
  respondsFast    Boolean   @default(false) // responde en <24h de media
  gigsCount       Int       @default(0)     // nº de actuaciones declaradas/verificadas
  // --- Detalles que el cliente pregunta antes de contratar ---
  minDurationMin  Int? // duración mínima de la actuación, en minutos
  membersCount    Int? // nº de músicos que suben al escenario
  travelRadiusKm  Int? // hasta dónde se desplaza desde su ciudad
  equipmentIncluded Boolean @default(false) // sonido/luces propios incluidos
  languages       String? // CSV de idiomas del repertorio, p.ej. "es,en,it"
  formats         String? // CSV: "acustico,electrico"
  venueTypes      String? // CSV: "interior,exterior"
  repertoire      String? // temas/estilos destacados, texto libre
  influences      String? // referencias musicales, texto libre
  /// Política de cancelación que el artista aplica por defecto.
  cancellationPolicy String @default("moderada")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  artistTypes  ArtistType[]  @relation("MusicianArtistTypes")
  genres       Genre[]       @relation("MusicianGenres")
  eventTypes   EventType[]   @relation("MusicianEventTypes")
  instruments  Instrument[]  @relation("MusicianInstruments")

  media           Media[]
  availability    AvailabilityBlock[]
  bookingRequests BookingRequest[]
  reviews         Review[]
  favoritedBy     Favorite[]
  packages        PricingPackage[]

  @@index([city])
  @@index([status])
  @@index([featured])
  @@index([verified])
}

/// Paquetes de precio configurables por el músico (Pack Ceremonia, Pack Cóctel…).
/// Hacen el precio transparente sin comprometer al artista a una tarifa cerrada:
/// `priceFrom` del perfil sigue siendo el "desde" global.
model PricingPackage {
  id          String          @id @default(cuid())
  musicianId  String
  musician    MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  name        String // "Pack Ceremonia"
  description String?
  price       Int // euros
  durationMin Int? // duración incluida, en minutos
  includes    String? // CSV de lo que incluye, una línea por elemento
  order       Int             @default(0)

  @@index([musicianId])
}

// ---------- Taxonomías (gestionables desde /admin) ----------

model ArtistType {
  id    String @id @default(cuid())
  slug  String @unique
  label String
  icon  String?
  order Int    @default(0)

  /// Disciplina: "musico" (cantantes, bandas, DJs…) o "escenico" (baile, magia,
  /// humor, circo…). Son dos mercados con búsqueda, precio y expectativas
  /// distintas, así que se navegan y se filtran por separado.
  kind String @default("musico")

  musicians MusicianProfile[] @relation("MusicianArtistTypes")

  @@index([kind])
}

model Genre {
  id        String            @id @default(cuid())
  slug      String            @unique
  label     String
  order     Int               @default(0)
  musicians MusicianProfile[] @relation("MusicianGenres")
}

model EventType {
  id        String            @id @default(cuid())
  slug      String            @unique
  label     String
  icon      String?
  order     Int               @default(0)
  musicians MusicianProfile[] @relation("MusicianEventTypes")
}

model Instrument {
  id        String            @id @default(cuid())
  slug      String            @unique
  label     String
  musicians MusicianProfile[] @relation("MusicianInstruments")
}

// ---------- Multimedia ----------

model Media {
  id         String          @id @default(cuid())
  musicianId String
  musician   MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  type       String // photo | video | audio
  url        String
  provider   String? // youtube | vimeo | upload
  title      String?
  order      Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([musicianId, type])
}

// ---------- Disponibilidad ----------

model AvailabilityBlock {
  id         String          @id @default(cuid())
  musicianId String
  musician   MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  date       DateTime
  available  Boolean         @default(false) // false = fecha bloqueada/no disponible

  @@unique([musicianId, date])
}

// ---------- Solicitudes de presupuesto ----------

model BookingRequest {
  id           String          @id @default(cuid())
  musicianId   String
  musician     MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  clientUserId String?
  clientUser   User?           @relation(fields: [clientUserId], references: [id])
  guestName    String
  guestEmail   String
  guestPhone   String?
  eventType    String
  eventDate    DateTime?
  city         String?
  budgetMin    Int?
  budgetMax    Int?
  message      String?
  status       String          @default("pending") // pending | accepted | declined | completed

  // --- Facturación (comisión partida, ver src/lib/pricing.ts) ---
  /// Precio acordado con el artista, sin comisiones. Se fija al aceptar.
  agreedPrice      Int?
  /// Importes congelados en el momento de aceptar: si mañana cambian las
  /// tarifas de la plataforma, esta reserva mantiene las condiciones pactadas.
  clientFee        Int?
  clientTotal      Int?
  artistCommission Int?
  artistPayout     Int?
  paymentStatus    String    @default("none") // ver PAYMENT_STATUSES
  cancellationPolicy String  @default("moderada")
  /// Momento en que el dinero deja de estar en custodia y se liquida.
  payoutReleaseAt  DateTime?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  messages Message[]
  review   Review?

  @@index([musicianId, status])
  @@index([clientUserId])
}

model Message {
  id               String         @id @default(cuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  senderId         String?
  sender           User?          @relation(fields: [senderId], references: [id])
  senderRole       String // client | musician
  body             String
  createdAt        DateTime       @default(now())

  @@index([bookingRequestId])
}

// ---------- Reseñas ----------

model Review {
  id               String          @id @default(cuid())
  musicianId       String
  musician         MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  bookingRequestId String?         @unique
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id])
  authorUserId     String?
  authorUser       User?           @relation(fields: [authorUserId], references: [id])
  authorName       String
  eventType        String?
  rating           Int // valoración global 1-5 (la que se muestra en tarjetas)
  comment          String?
  approved         Boolean         @default(false)

  // Sub-puntuaciones opcionales: dan contexto real sobre por qué la nota global
  // es la que es, y permiten mostrar desgloses en el perfil.
  ratingMusic          Int? // calidad musical
  ratingProfessionalism Int?
  ratingPunctuality    Int?
  ratingCommunication  Int?
  ratingValue          Int? // relación calidad/precio

  /// true cuando la reseña procede de una BookingRequest completada en Sonora.
  /// Es la diferencia entre "una opinión" y "una contratación verificada".
  verifiedBooking  Boolean         @default(false)

  createdAt        DateTime        @default(now())

  @@index([musicianId, approved])
}

// ---------- Favoritos ----------

model Favorite {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  musicianId String
  musician   MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([userId, musicianId])
}
